#!/bin/bash -e

FOLDERSTAMP_VERSION="r7"

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

platform_name() {
    local uname_s uname_o
    uname_s="$(uname -s 2>/dev/null || echo unknown)"
    uname_o="$(uname -o 2>/dev/null || echo unknown)"

    if [[ -n "${TERMUX_VERSION:-}" ]] || [[ "${PREFIX:-}" == *com.termux* ]] || [[ "$uname_o" == "Android" ]]; then
        echo "Termux"
    elif [[ "$uname_s" == CYGWIN* ]]; then
        echo "Cygwin"
    elif [[ "$uname_s" == "Redox" ]]; then
        echo "RedoxOS"
    else
        echo "$uname_s"
    fi
}


install_command_for() {
    local package="$1"
    local platform
    platform="$(platform_name)"

    case "$platform" in
        Termux)
            echo "pkg install $package"
            ;;
        Cygwin)
            echo "Install the '$package' package with the Cygwin setup executable."
            ;;
        RedoxOS)
            echo "pkg install $package"
            ;;
        Linux)
            if command_exists apt-get; then
                echo "sudo apt-get update && sudo apt-get install -y $package"
            elif command_exists dnf; then
                echo "sudo dnf install -y $package"
            elif command_exists pacman; then
                echo "sudo pacman -S --needed $package"
            elif command_exists apk; then
                echo "sudo apk add $package"
            elif command_exists zypper; then
                echo "sudo zypper install -y $package"
            else
                echo "Install '$package' with your distribution package manager."
            fi
            ;;
        *)
            echo "Install '$package' with the package manager for $(platform_name)."
            ;;
    esac
}

kubo_install_offer() {
    cat <<'KUBO_EOF'
Dependency notice: ipfs is not installed.
Kubo is the reference IPFS implementation; you can download it from GitHub Releases:
  https://github.com/ipfs/kubo/releases/latest
Choose the release asset that matches your OS and CPU architecture, then run the install script shipped in the archive.
Linux example after downloading the correct tarball:
  tar -xzf kubo_*.tar.gz
  cd kubo && sudo ./install.sh
Termux users should install into $PREFIX/bin instead of relying on sudo.
KUBO_EOF
}

check_dependency() {
    local command_name="$1"
    local package_name="${2:-$1}"

    if command_exists "$command_name"; then
        echo "Dependency OK: $command_name ($(command -v "$command_name"))"
        return 0
    fi

    echo "Dependency missing: $command_name"

    if [[ "$command_name" == "ipfs" ]]; then
        kubo_install_offer
    else
        echo "Suggested install: $(install_command_for "$package_name")"
    fi

    return 1
}

print_dependency_report() {
    echo "Dependency check:"
    check_dependency stat coreutils || true
    check_dependency git git || true
    check_dependency ipfs kubo || true
}

print_storage_details() {
    local mount_source
    mount_source="$(df -P . 2>/dev/null | awk 'NR==2 {print $1}')"

    if [[ -n "$mount_source" ]] && command_exists lsblk; then
        lsblk -o NAME,SIZE,TYPE,VENDOR,MODEL 2>/dev/null \
            | awk -v device="$mount_source" 'index(device, "/" $1) || device == $1 {print "Storage Device: " $0}'
        return 0
    fi

    if command_exists df; then
        df -hP . 2>/dev/null | awk 'NR==2 {print "Storage Device: " $1 " mounted on " $6 " (" $2 " total, " $4 " available)"}'
        return 0
    fi

    echo "Storage Device: unavailable on this platform"
}

print_git_details() {
    local current_branch first_remote_name first_remote_url

    if [[ -d ".git" ]] && command_exists git; then
        current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
        first_remote_name="$(git remote 2>/dev/null | head -n1)"
        echo "Current Git Branch: ${current_branch:-unknown}"

        if [[ -n "$first_remote_name" ]]; then
            first_remote_url="$(git remote get-url "$first_remote_name" 2>/dev/null || true)"
            echo "First Git Remote: $first_remote_name - URL: ${first_remote_url:-unknown}"
        else
            echo "First Git Remote: none"
        fi
    fi
}

print_ipfs_hash() {
    local file="$1"

    if command_exists ipfs; then
        echo "IPFS hash: $(ipfs add -q --only-hash "$file")"
    else
        echo "IPFS hash: unavailable (ipfs command not found)"
    fi
}

stamp_path() {
    local file="$1"
    local all

    all=$(printf '\n'; if command_exists stat; then stat "$file" 2>/dev/null || echo "stat failed for: $file"; else echo "stat unavailable for: $file"; echo "Suggested install: $(install_command_for coreutils)"; fi; print_ipfs_hash "$file"; printf '%s\n' '------------------------------')
    printf "%s" "$all" | sed 's/%/%%/g'
}

function display {
rocketlaunch_dir=`pwd` #from https://unix.stackexchange.com/a/52919/470623
echo "This folder: $rocketlaunch_dir"
echo "Platform: $(platform_name)"
#-
# Add storage device details with fallbacks for Linux, Termux, Cygwin and RedoxOS.
print_storage_details
#-
echo "folderstamp version: $FOLDERSTAMP_VERSION"
if [[ "$2" == "--recursive" ]] || [[ "$2" == "-r" ]]; then
   method="Recursive"
else
   method="Non-recursive"
fi
echo "Method: $method"  # Add this line to show the method used

# Display current git branch and first git remote name with URL if .git folder is present
print_dependency_report
print_git_details

if [[ "$2" == "--recursive" ]] || [[ "$2" == "-r" ]]
   then
find . -type f -name '*' -print0 | while IFS= read -r -d '' file
do
    stamp_path "$file"
done
# from https://stackoverflow.com/a/25948226/5623661
   else
# NOTE : Quote it else use array to avoid problems #
for file in ./*
do
  stamp_path "$file"
# from https://stackoverflow.com/a/25948226/5623661
done
# based from https://www.cyberciti.biz/faq/bash-loop-over-file/
fi
}

if [ "$1" = "save" ];then
   echo "🤓📝 Working..."
   display "$1" "$2" > .folderstamp
fi
if [ "$1" = "display" ];then
   display "$1" "$2"
fi

