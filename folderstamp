check_dependency() {
    local command_name="$1"
    local package_name="${2:-$1}"

    if command_exists "$command_name"; then
        echo "Dependency OK: $command_name ($(command -v "$command_name"))"
        return 0
    fi

    echo "Dependency missing: $command_name"

    echo "Suggested install: $(install_command_for "$package_name")"

    return 1
}

tool_status() {
    local command_name="$1"

    if command_exists "$command_name"; then
        printf '%s=%s' "$command_name" "$(command -v "$command_name")"
    else
        printf '%s=missing' "$command_name"
    fi
}

# Disabled Python-based BLAKE3 status helper.
: <<'FOLDERSTAMP_DISABLED_PYTHON_STATUS'
python_blake3_status() {
    if command_exists python3 && python3 -c 'import blake3' >/dev/null 2>&1; then
        printf 'python-blake3=available'
    else
        printf 'python-blake3=missing'
    fi
}
FOLDERSTAMP_DISABLED_PYTHON_STATUS


print_dependency_report() {
    # A stamp is an enduring record, not an installer transcript. Keep the
    # environment summary on one line; interactive install guidance remains in
    # the dedicated check_* helpers for callers that need it.
    printf 'Tooling: %s; %s; %s; %s; %s; %s; %s\n' \
        "$(tool_status stat)" \
        "$(tool_status git)" \
        "$(tool_status gix)" \
        "$(tool_status pijul)" \
        "$(tool_status iroh)" \
        "$(tool_status b3sum)" \
        "$(tool_status ipfs)"
}

print_storage_details() {
    local mount_source df_output

    mount_source=""
    if command_exists df && command_exists awk; then
        # Avoid assuming GNU df options are present on Android/toybox systems.
        mount_source="$(df -P . 2>/dev/null | awk 'NR==2 {print $1}')" || mount_source=""
    fi

    if [[ -n "$mount_source" ]] && command_exists lsblk && command_exists awk; then
        local lsblk_output
        lsblk_output="$(lsblk -o NAME,SIZE,TYPE,VENDOR,MODEL 2>/dev/null |
            awk -v device="$mount_source" 'index(device, "/" $1) || device == $1 {print $0}')" || lsblk_output=""
        if [[ -n "$lsblk_output" ]]; then
            printf 'Storage Device: %s\n' "$lsblk_output"
            return 0
        fi
    fi

    if command_exists df && command_exists awk; then
        df_output="$(df -hP . 2>/dev/null)" || df_output=""
        if [[ -n "$df_output" ]]; then
            printf '%s\n' "$df_output" |
                awk 'NR==2 {print "Storage Device: " $1 " mounted on " $6 " (" $2 " total, " $4 " available)"}' || true
            return 0
        fi
    fi

    echo "Storage Device: unavailable on this platform"
}

print_git_details() {
    local current_branch first_remote_name first_remote_url remote_scheme remote_rest

    if [[ -d ".git" ]] && command_exists git; then
        current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
        first_remote_name="$(git remote 2>/dev/null | head -n1)"
        echo "Current Git Branch: ${current_branch:-unknown}"

        if [[ -n "$first_remote_name" ]]; then
            first_remote_url="$(git remote get-url "$first_remote_name" 2>/dev/null || true)"
            # Prevent embedded HTTPS credentials/tokens leaking into a snapshot.
            if [[ "$first_remote_url" == *://*@* ]]; then
                remote_scheme="${first_remote_url%%://*}"
                remote_rest="${first_remote_url#*://}"
                first_remote_url="${remote_scheme}://[credentials-redacted]@${remote_rest#*@}"
            fi
            echo "First Git Remote: $first_remote_name - URL: ${first_remote_url:-unknown}"
        else
            echo "First Git Remote: none"
        fi
    elif [[ -d ".git" ]] && command_exists gix; then
        echo "Git repository detected; Gitoxide available: $(command -v gix)"
        echo "Current Git Branch: unavailable without classic git"
    fi
}

print_pijul_details() {
    local current_channel

    if [[ -d ".pijul" ]] && command_exists pijul; then
        current_channel="$(pijul channel 2>/dev/null | awk '/\*/ {print $2; exit}')"
        echo "Current Pijul Channel: ${current_channel:-unknown}"
    elif [[ -d ".pijul" ]]; then
        echo "Pijul repository detected, but pijul is not installed."
        echo "Suggested install: $(install_command_for pijul)"
    fi
}

# Python-based CID methods are intentionally disabled for now.
# Implement the interoperable CIDv1 encoder directly in Bash; see to-do.md.
# The legacy Iroh blobs-add method is disabled because it stores content locally.
: <<'FOLDERSTAMP_DISABLED_LEGACY_HASH_METHODS'
cid_v0_basic_python() {
    local file="$1"

    python3 - "$file" <<'PY_CID'
import hashlib
import sys

ALPHABET = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"


def varint(value: int) -> bytes:
    out = bytearray()
    while value >= 0x80:
        out.append((value & 0x7F) | 0x80)
        value >>= 7
    out.append(value)
    return bytes(out)


def field_varint(number: int, value: int) -> bytes:
    return varint((number << 3) | 0) + varint(value)


def field_bytes(number: int, value: bytes) -> bytes:
    return varint((number << 3) | 2) + varint(len(value)) + value


def b58encode(data: bytes) -> str:
    n = int.from_bytes(data, "big")
    chars = []
    while n:
        n, rem = divmod(n, 58)
        chars.append(ALPHABET[rem])
    prefix = "1" * (len(data) - len(data.lstrip(b"\0")))
    return prefix + "".join(reversed(chars or ["1"]))

path = sys.argv[1]
with open(path, "rb") as handle:
    payload = handle.read()

# Basic CIDv0 study/implementation for a single-block UnixFS file:
# UnixFS Data: Type=File(2), Data=<bytes>, filesize=<len>.
unixfs_data = field_varint(1, 2) + field_bytes(2, payload) + field_varint(3, len(payload))
# DAG-PB PBNode: Data=<UnixFS Data>. No links/chunking in this basic fallback.
pb_node = field_bytes(1, unixfs_data)
digest = hashlib.sha256(pb_node).digest()
multihash = bytes([0x12, 0x20]) + digest
print(b58encode(multihash))
PY_CID
}

cid_v1_blake3_python() {
    local file="$1"

    python3 - "$file" <<'PY_BLAKE3'
import base64
import sys
import blake3


def varint(value: int) -> bytes:
    out = bytearray()
    while value >= 0x80:
        out.append((value & 0x7F) | 0x80)
        value >>= 7
    out.append(value)
    return bytes(out)

with open(sys.argv[1], "rb") as handle:
    digest = blake3.blake3(handle.read()).digest()

# CIDv1 + raw codec (0x55) + BLAKE3-256 multihash (0x1e, 32 bytes).
cid = varint(1) + varint(0x55) + varint(0x1e) + varint(len(digest)) + digest
print("b" + base64.b32encode(cid).decode("ascii").lower().rstrip("="))
PY_BLAKE3
}

iroh_blake3_hash() {
    local file="$1"
    local output hash

    # The legacy Iroh CLI starts a local node when asked, then reports the blob hash.
    output="$(iroh --start blobs add --no-ticket "$file" 2>&1)" || return 1
    # Iroh 0.28 prints `Blob: <BlobId>`; retain the older Hash-shaped output
    # matcher as well so this parser stays useful across the supported CLI line.
    hash="$(printf '%s\n' "$output" | sed -nE \
        -e 's/^Blob:[[:space:]]+([^[:space:]]+).*$/\1/p' \
        -e 's/^(Blob )?[Hh]ash:?[[:space:]]+([^[:space:]]+).*$/\2/p' | head -n1)"
    [[ -n "$hash" ]] || return 1
    printf '%s\n' "$hash"
}

iroh_blob_id_to_cid_v1() {
    local blob_id="$1"

    python3 - "$blob_id" <<'PY_IROH_CID'
import base64
import sys


def varint(value: int) -> bytes:
    out = bytearray()
    while value >= 0x80:
        out.append((value & 0x7F) | 0x80)
        value >>= 7
    out.append(value)
    return bytes(out)


# Iroh BlobIds are unpadded base32 encodings of the BLAKE3-256 digest. Wrap
# that digest in CIDv1/raw + the registered BLAKE3-256 multihash code (0x1e).
blob_id = sys.argv[1]
padded = blob_id.upper() + "=" * (-len(blob_id) % 8)
digest = base64.b32decode(padded, casefold=True)
if len(digest) != 32:
    raise ValueError("an Iroh BlobId must encode a 32-byte BLAKE3 digest")
cid = varint(1) + varint(0x55) + varint(0x1E) + varint(len(digest)) + digest
print("b" + base64.b32encode(cid).decode("ascii").lower().rstrip("="))
PY_IROH_CID
}

print_cid_hash() {
    local file="$1"
    local hash cid

    if command_exists iroh && hash="$(iroh_blake3_hash "$file")" && \
        command_exists python3 && cid="$(iroh_blob_id_to_cid_v1 "$hash")"; then
        # Iroh calculates the preferred BLAKE3 digest; standard-library Python
        # merely wraps it in CIDv1/raw, without needing the blake3 module.
        echo "CID hash (CIDv1/raw/BLAKE3 via Iroh): $cid"
    elif command_exists iroh && hash="$(iroh_blake3_hash "$file")"; then
        echo "Content hash (Iroh BLAKE3): $hash (install Python 3 for CIDv1 wrapping)"
    elif command_exists python3 && python3 -c 'import blake3' >/dev/null 2>&1; then
        echo "CID hash (CIDv1/raw/BLAKE3): $(cid_v1_blake3_python "$file")"
    elif command_exists ipfs && hash="$(ipfs add -q --only-hash --cid-version=1 --raw-leaves --hash=blake3 "$file" 2>/dev/null)"; then
        # Kubo remains compatible, but is deliberately not the default provider.
        echo "CID hash (CIDv1/raw/BLAKE3 via Kubo/IPFS fallback): $hash"
    elif command_exists python3; then
        echo "CID hash (CIDv0 basic): $(cid_v0_basic_python "$file")"
    else
        echo "CID hash: unavailable (install Iroh, Python 3 + blake3, or Kubo/IPFS)"
    fi
}

FOLDERSTAMP_DISABLED_LEGACY_HASH_METHODS

print_content_hash() {
    local file="$1"
    local output hash

    if ! command_exists b3sum; then
        echo "BLAKE3-256 digest: unavailable (b3sum is not installed)"
        return 0
    fi

    # Read via stdin so b3sum streams the file without parsing its filename.
    if ! output="$(b3sum < "$file")"; then
        echo "BLAKE3-256 digest: failed (b3sum could not read the file)" >&2
        return 1
    fi

    # stdin is represented as "-", so b3sum prints "<digest>  -".
    hash="${output%%[[:space:]]*}"
    if [[ ! "$hash" =~ ^[[:xdigit:]]{64}$ ]]; then
        echo "BLAKE3-256 digest: failed (unexpected b3sum output)" >&2
        return 1
    fi

    printf 'BLAKE3-256 digest (Iroh-compatible): %s\n' "$hash"
    echo "CIDv1/raw/BLAKE3: pending native Bash encoder (see to-do.md)"
}

stamp_path() {
    local file="$1"
    local target

    printf '\n'
    if ! command_exists stat || ! stat "$file" 2>/dev/null; then
        printf 'stat failed for: %s\n' "$file"
        return 1
    fi

    if [[ -L "$file" ]]; then
        if command_exists readlink; then
            target="$(readlink "$file" 2>/dev/null)" || {
                printf 'Symlink target: unavailable\n'
                return 1
            }
            printf 'Symlink target: %s\n' "$target"
        else
            printf 'Symlink target: unavailable (readlink missing)\n'
        fi
        printf 'CID hash: skipped (symbolic link, not file content)\n'
    else
        print_content_hash "$file"
    fi

    printf '%s\n' '------------------------------'
}

folderstamp_store_dir() {
    echo ".meta/folderstamp"
}

legacy_folderstamp_path() {
    echo ".folderstamp"
}

next_folderstamp_path() {
    local store_dir="$1"
    local max=0
    local path name number

    # New rotations are .folderstamp, .folderstamp1, .folderstamp2, ... . Also
    # recognize the old dotted form so an upgrade never overwrites history.
    for path in "$store_dir"/.folderstamp "$store_dir"/.folderstamp[0-9]* "$store_dir"/.folderstamp.[0-9]*; do
        [[ -e "$path" || -L "$path" ]] || continue
        name="${path##*/}"
        if [[ "$name" == ".folderstamp" ]]; then
            max=0
            continue
        fi
        number="${name#.folderstamp}"
        number="${number#.}"
        if [[ "$number" =~ ^[0-9]+$ ]] && (( number > max )); then
            max="$number"
        fi
    done

    if [[ ! -e "$store_dir/.folderstamp" && ! -L "$store_dir/.folderstamp" ]]; then
        echo "$store_dir/.folderstamp"
    else
        echo "$store_dir/.folderstamp$((max + 1))"
    fi
}

prepare_folderstamp_store() {
    local store_dir legacy_path next_path

    store_dir="$(folderstamp_store_dir)"
    legacy_path="$(legacy_folderstamp_path)"

    # Do not follow metadata symlinks or migrate a symlink as if it were a stamp.
    if [[ -L .meta ]] || [[ -e .meta && ! -d .meta ]]; then
        echo "Refusing to use .meta: expected a real directory." >&2
        return 1
    fi
    if [[ -L "$store_dir" ]] || [[ -e "$store_dir" && ! -d "$store_dir" ]]; then
        echo "Refusing to use $store_dir: expected a real directory." >&2
        return 1
    fi
    mkdir -p "$store_dir"

    if [[ -L "$legacy_path" ]]; then
        echo "Refusing to migrate legacy $legacy_path because it is a symbolic link." >&2
        return 1
    fi
    if [[ -e "$legacy_path" && ! -f "$legacy_path" ]]; then
        echo "Refusing to migrate legacy $legacy_path because it is not a regular file." >&2
        return 1
    fi

    # Keep legacy data; never replace a numbered snapshot.
    while [[ -f "$legacy_path" ]]; do
        next_path="$(next_folderstamp_path "$store_dir")"
        if ! mv -n "$legacy_path" "$next_path"; then
            echo "Could not preserve legacy stamp $legacy_path." >&2
            return 1
        fi
        # mv -n can report success without moving when another process wins.
        [[ -e "$legacy_path" ]] || break
    done
}

folderstamp_is_internal() {
    local file="${1#./}"
    local basename="${file##*/}"

    case "$file" in
        .git|*/.git|.git/*|*/.git/*) return 0 ;;
        .pijul|*/.pijul|.pijul/*|*/.pijul/*) return 0 ;;
        .hg|*/.hg|.hg/*|*/.hg/*) return 0 ;;
        .svn|*/.svn|.svn/*|*/.svn/*) return 0 ;;
        .meta/folderstamp|.meta/folderstamp/*|*/.meta/folderstamp|*/.meta/folderstamp/*)
            return 0 ;;
    esac

    case "$basename" in
        .folderstamp*|.folderstampignore|.git|.pijul|.hg|.svn)
            return 0 ;;
    esac
    return 1
}

folderstamp_ignore_matches() {
    local file="${1#./}"
    local pattern="$2"
    local basename="${file##*/}"
    local anchored=0 directory_only=0

    [[ "$pattern" == /* ]] && anchored=1 && pattern="${pattern#/}"
    [[ "$pattern" == */ ]] && directory_only=1 && pattern="${pattern%/}"
    [[ -z "$pattern" ]] && return 1

    if (( anchored )); then
        [[ "$file" == $pattern || "$file" == $pattern/* ]]
    elif (( directory_only )); then
        [[ "$file" == $pattern/* || "$file" == */$pattern/* ]]
    elif [[ "$pattern" == */* ]]; then
        [[ "$file" == $pattern || "$file" == */$pattern ]]
    else
        [[ "$basename" == $pattern || "$file" == */$pattern ]]
    fi
}

folderstamp_is_ignored() {
    local file="$1"
    local line pattern ignored=1

    folderstamp_is_internal "$file" && return 0
    [[ -f ".folderstampignore" ]] || return 1

    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}"
        [[ -z "$line" || "$line" == \#* ]] && continue
        if [[ "$line" == !* ]]; then
            pattern="${line#!}"
            folderstamp_ignore_matches "$file" "$pattern" && ignored=1
        elif folderstamp_ignore_matches "$file" "$line"; then
            ignored=0
        fi
    done < .folderstampignore

    (( ignored == 0 ))
}

should_stamp_path() {
    # Include links as directory entries, including broken links, without following them.
    { [[ -f "$1" ]] || [[ -L "$1" ]]; } && ! folderstamp_is_ignored "$1"
}

print_snapshot_header() {
    local mode="$1"

    echo "This folder: $(pwd)"
    echo "Platform: $(platform_name)"
    print_storage_details
    echo "folderstamp version: $FOLDERSTAMP_VERSION"
    if [[ "$mode" == "recursive" ]]; then
        echo "Method: Recursive"
    else
        echo "Method: Non-recursive"
    fi
    print_dependency_report
    print_git_details
    print_pijul_details
}

build_snapshot_file_list() {
    local mode="$1"
    local list_file="$2"
    local work_dir="$3"
    local candidates="$work_dir/candidates"
    local list_tmp="$list_file.tmp"
    local file

    : > "$list_tmp"

    if [[ "$mode" == "recursive" ]]; then
        if ! find . \( -type d \( \
            -name .git -o -name .pijul -o -name .hg -o -name .svn -o \
            -path './.meta/folderstamp' \
        \) -prune \) -o \( \( -type f -o -type l \) -print0 \) > "$candidates"; then
            echo "Could not enumerate files for the snapshot." >&2
            return 1
        fi

        while IFS= read -r -d '' file; do
            if should_stamp_path "$file"; then
                printf '%s\0' "$file" >> "$list_tmp" || return 1
            fi
        done < "$candidates"
    else
        shopt -s dotglob nullglob
        for file in ./*; do
            if should_stamp_path "$file"; then
                printf '%s\0' "$file" >> "$list_tmp" || return 1
            fi
        done
    fi

    mv "$list_tmp" "$list_file" || return 1
    # Persist the manifest publication before any checkpoint can trust it.
    sync || {
        echo "Could not sync the published file list." >&2
        return 1
    }
    rm -f "$candidates"
}

snapshot_file_list_metadata() {
    local list_file="$1"
    local bytes crc count last_byte

    [[ -f "$list_file" && ! -L "$list_file" ]] || return 1
    bytes="$(wc -c < "$list_file")" || return 1
    bytes="${bytes//[[:space:]]/}"
    read -r crc _ < <(cksum < "$list_file") || return 1
    [[ "$crc" =~ ^[0-9]+$ ]] || return 1

    count=0
    while IFS= read -r -d '' _entry; do
        count=$((count + 1))
    done < "$list_file"

    # A non-empty manifest must end at a NUL boundary. A truncated final
    # pathname is otherwise silently ignored by Bash's read -d '' loop.
    if (( bytes > 0 )); then
        last_byte="$(tail -c 1 "$list_file" | od -An -tu1 | tr -d '[:space:]')" || return 1
        [[ "$last_byte" == "0" ]] || return 1
    fi

    printf '%s %s %s\n' "$bytes" "$crc" "$count"
}

validate_snapshot_file_list() {
    local list_file="$1"
    local expected_bytes="$2"
    local expected_crc="$3"
    local expected_count="$4"
    local actual

    [[ "$expected_bytes" =~ ^[0-9]+$ && "$expected_crc" =~ ^[0-9]+$ && "$expected_count" =~ ^[0-9]+$ ]] || return 1
    actual="$(snapshot_file_list_metadata "$list_file")" || return 1
    [[ "$actual" == "$expected_bytes $expected_crc $expected_count" ]]
}

write_snapshot_checkpoint() {
    local checkpoint="$1"
    local root="$2"
    local mode="$3"
    local processed="$4"
    local safe_bytes="$5"
    local list_bytes="${6:-pending}"
    local list_crc="${7:-pending}"
    local list_count="${8:-pending}"
    local checkpoint_tmp

    command_exists sync || {
        echo "Cannot guarantee resumable snapshots: sync is missing." >&2
        return 1
    }
    checkpoint_tmp="$(mktemp "$checkpoint.XXXXXX")" || return 1

    if ! printf '%s\0%s\0%s\0%s\0%s\0%s\0%s\0' \
        "$root" "$mode" "$processed" "$safe_bytes" \
        "$list_bytes" "$list_crc" "$list_count" > "$checkpoint_tmp"; then
        rm -f "$checkpoint_tmp"
        return 1
    fi

    # The manifest is synced before advancing the checkpoint. After a crash,
    # the checkpoint therefore never intentionally points past durable output.
    sync || return 1
    if ! mv -f "$checkpoint_tmp" "$checkpoint"; then
        rm -f "$checkpoint_tmp"
        return 1
    fi
    sync
}

resume_folderstamp() {
    local incomplete="$1"
    local work_dir store_dir expected_store work_real checkpoint list_file entry_file
    local saved_root saved_mode saved_processed saved_bytes root_now actual_bytes
    local saved_list_bytes saved_list_crc saved_list_count list_metadata
    local final_path

    ensure_b3sum || true

    if [[ -z "$incomplete" || ! -f "$incomplete" || -L "$incomplete" ]]; then
        echo "Select an existing regular *.incomplete snapshot file." >&2
        return 1
    fi
    if [[ "${incomplete##*/}" != "folderstamp.incomplete" ]]; then
        echo "The selected file must be named folderstamp.incomplete." >&2
        return 1
    fi

    work_dir="$(dirname "$incomplete")"
    store_dir="$(folderstamp_store_dir)"
    if [[ ! -d "$work_dir" || -L "$work_dir" || ! -d "$store_dir" ]]; then
        echo "Incomplete snapshot workspace is missing or unsafe." >&2
        return 1
    fi

    expected_store="$(cd "$store_dir" && pwd -P)" || return 1
    work_real="$(cd "$work_dir" && pwd -P)" || return 1
    case "$work_real" in
        "$expected_store"/.folderstamp.incomplete.*) ;;
        *)
            echo "The selected incomplete file is not in this folder's Folderstamp workspace." >&2
            return 1 ;;
    esac

    checkpoint="$work_dir/checkpoint"
    list_file="$work_dir/files.list"
    entry_file="$work_dir/current-entry"

    if [[ ! -f "$checkpoint" || -L "$checkpoint" ]]; then
        echo "Checkpoint data is missing or unsafe; the incomplete file was preserved." >&2
        return 1
    fi

    # The NUL-delimited fields keep unusual directory names safe.
    exec 9< "$checkpoint"
    IFS= read -r -d '' saved_root <&9 || { exec 9<&-; echo "Invalid checkpoint root." >&2; return 1; }
    IFS= read -r -d '' saved_mode <&9 || { exec 9<&-; echo "Invalid checkpoint mode." >&2; return 1; }
    IFS= read -r -d '' saved_processed <&9 || { exec 9<&-; echo "Invalid checkpoint count." >&2; return 1; }
    IFS= read -r -d '' saved_bytes <&9 || { exec 9<&-; echo "Invalid checkpoint size." >&2; return 1; }
    if ! IFS= read -r -d '' saved_list_bytes <&9; then
        # Older r6.1 checkpoints have only four fields. They can be upgraded
        # safely only while no snapshot entry has been committed.
        saved_list_bytes="pending"
        saved_list_crc="pending"
        saved_list_count="pending"
    else
        IFS= read -r -d '' saved_list_crc <&9 || { exec 9<&-; echo "Invalid manifest checksum in checkpoint." >&2; return 1; }
        IFS= read -r -d '' saved_list_count <&9 || { exec 9<&-; echo "Invalid manifest count in checkpoint." >&2; return 1; }
    fi
    exec 9<&-

    if [[ ! "$saved_processed" =~ ^[0-9]+$ || ! "$saved_bytes" =~ ^[0-9]+$ ]]; then
        echo "Checkpoint counters are invalid; the incomplete file was preserved." >&2
        return 1
    fi
    if [[ "$saved_list_bytes" != "pending" || "$saved_list_crc" != "pending" || "$saved_list_count" != "pending" ]]; then
        if [[ ! "$saved_list_bytes" =~ ^[0-9]+$ || ! "$saved_list_crc" =~ ^[0-9]+$ || ! "$saved_list_count" =~ ^[0-9]+$ ]]; then
            echo "Manifest checkpoint metadata is invalid; the incomplete file was preserved." >&2
            return 1
        fi
    elif (( saved_processed != 0 || saved_bytes != 0 )); then
        echo "The manifest was not committed before snapshot data; refusing unsafe resume." >&2
        return 1
    fi
    if [[ "$saved_mode" != "recursive" && "$saved_mode" != "non-recursive" ]]; then
        echo "Checkpoint mode is invalid." >&2
        return 1
    fi

    root_now="$(pwd -P)"
    if [[ "$saved_root" != "$root_now" ]]; then
        echo "Resume from the original directory: $saved_root" >&2
        return 1
    fi

    # A pending manifest checkpoint means a crash may have happened before
    # its metadata was committed. Rebuild it from the source tree only while
    # no snapshot entries have been processed.
    if [[ "$saved_list_bytes" == "pending" ]]; then
        rm -f "$list_file" "$list_file.tmp" "$work_dir/candidates"
        if ! build_snapshot_file_list "$saved_mode" "$list_file" "$work_dir"; then
            echo "Could not rebuild the file list. Incomplete data remains at: $incomplete" >&2
            return 1
        fi
        list_metadata="$(snapshot_file_list_metadata "$list_file")" || {
            echo "Could not validate the rebuilt file list." >&2
            return 1
        }
        read -r saved_list_bytes saved_list_crc saved_list_count <<< "$list_metadata"
        write_snapshot_checkpoint "$checkpoint" "$saved_root" "$saved_mode" "$saved_processed" "$saved_bytes" "$saved_list_bytes" "$saved_list_crc" "$saved_list_count" || return 1
    elif ! validate_snapshot_file_list "$list_file" "$saved_list_bytes" "$saved_list_crc" "$saved_list_count"; then
        echo "The saved file list is missing, truncated, or changed; incomplete data was preserved." >&2
        return 1
    fi

    actual_bytes=$(( $(wc -c < "$incomplete") ))
    if (( actual_bytes < saved_bytes )); then
        echo "The incomplete file is shorter than its last durable checkpoint; refusing to discard or guess data." >&2
        return 1
    fi
    if (( actual_bytes > saved_bytes )); then
        command_exists truncate || {
            echo "Resume needs the truncate command; install coreutils and try again." >&2
            return 1
        }
        truncate -s "$saved_bytes" "$incomplete" || return 1
        sync || return 1
    fi

    # A zero-byte checkpoint means the header had not been committed yet.
    if (( saved_bytes == 0 )); then
        if ! print_snapshot_header "$saved_mode" > "$incomplete"; then
            echo "Could not write the snapshot header." >&2
            return 1
        fi
        sync || return 1
        saved_bytes=$(( $(wc -c < "$incomplete") ))
        write_snapshot_checkpoint "$checkpoint" "$saved_root" "$saved_mode" "$saved_processed" "$saved_bytes" || return 1
    fi

    echo "Resuming incomplete snapshot: $incomplete"
    local processed=0 file next_bytes
    while IFS= read -r -d '' file; do
        processed=$((processed + 1))
        if (( processed <= saved_processed )); then
            continue
        fi

        if [[ ! -f "$file" && ! -L "$file" ]]; then
            printf '\nFile no longer exists; omitted from this snapshot: %q\n------------------------------\n' "$file" > "$entry_file"
        elif ! stamp_path "$file" > "$entry_file"; then
            echo "Could not stamp: $file" >&2
            echo "Incomplete work preserved at: $incomplete" >&2
            return 1
        fi

        if ! cat "$entry_file" >> "$incomplete"; then
            echo "Could not append the current entry; incomplete work preserved at: $incomplete" >&2
            return 1
        fi
        sync || {
            echo "Could not sync snapshot data; resume file preserved at: $incomplete" >&2
            return 1
        }
        next_bytes=$(( $(wc -c < "$incomplete") ))
        if ! write_snapshot_checkpoint "$checkpoint" "$saved_root" "$saved_mode" "$processed" "$next_bytes"; then
            echo "Could not advance the checkpoint; resume file preserved at: $incomplete" >&2
            return 1
        fi
    done < "$list_file"

    # Publish only a complete manifest. mv -n plus the post-check avoids
    # replacing a rotation created by another concurrent save.
    while :; do
        final_path="$(next_folderstamp_path "$store_dir")"
        if [[ -e "$final_path" || -L "$final_path" ]]; then
            continue
        fi
        if mv -n "$incomplete" "$final_path" && [[ ! -e "$incomplete" ]]; then
            break
        fi
        if [[ ! -e "$incomplete" ]]; then
            echo "Snapshot may have been published, but its final path could not be confirmed." >&2
            return 1
        fi
    done

    rm -f "$checkpoint" "$list_file" "$entry_file" "$list_file.tmp" "$work_dir/candidates"
    rmdir "$work_dir" 2>/dev/null || true
    echo "Saved completed folderstamp: $final_path"
}

save_folderstamp() {
    local store_dir work_dir incomplete root mode

    ensure_b3sum || true
    store_dir="$(folderstamp_store_dir)"
    prepare_folderstamp_store || return 1
    command_exists mktemp || {
        echo "Cannot save safely: mktemp is missing." >&2
        return 1
    }
    command_exists sync || {
        echo "Cannot create a resumable snapshot safely: sync is missing." >&2
        return 1
    }

    if [[ "$2" == "--recursive" || "$2" == "-r" ]]; then
        mode="recursive"
    else
        mode="non-recursive"
    fi

    work_dir="$(mktemp -d "$store_dir/.folderstamp.incomplete.XXXXXX")" || return 1
    incomplete="$work_dir/folderstamp.incomplete"
    root="$(pwd -P)"

    # The .incomplete extension is present from the beginning. A power loss
    # therefore leaves a clearly named recovery candidate, not an anonymous tmp.
    : > "$incomplete"
    if ! write_snapshot_checkpoint "$work_dir/checkpoint" "$root" "$mode" 0 0; then
        echo "Incomplete workspace preserved at: $incomplete" >&2
        return 1
    fi

    if ! build_snapshot_file_list "$mode" "$work_dir/files.list" "$work_dir"; then
        echo "Could not prepare the file list. Incomplete workspace preserved at: $incomplete" >&2
        return 1
    fi

    local list_metadata list_bytes list_crc list_count
    list_metadata="$(snapshot_file_list_metadata "$work_dir/files.list")" || {
        echo "Could not calculate file-list integrity metadata." >&2
        return 1
    }
    read -r list_bytes list_crc list_count <<< "$list_metadata"
    if ! write_snapshot_checkpoint "$work_dir/checkpoint" "$root" "$mode" 0 0 "$list_bytes" "$list_crc" "$list_count"; then
        echo "Could not commit file-list integrity metadata. Incomplete workspace preserved at: $incomplete" >&2
        return 1
    fi

    resume_folderstamp "$incomplete"
}

display() {
    local mode file

    ensure_b3sum || true

    if [[ "$2" == "--recursive" || "$2" == "-r" ]]; then
        mode="recursive"
    else
        mode="non-recursive"
    fi

    print_snapshot_header "$mode"

    if [[ "$mode" == "recursive" ]]; then
        command_exists find || {
            echo "Cannot use recursive mode: find is missing." >&2
            return 1
        }
        find . \( -type d \( -name .git -o -name .pijul -o -name .hg -o -name .svn -o -path './.meta/folderstamp' \) -prune \) -o \( \( -type f -o -type l \) -print0 \) |
        while IFS= read -r -d '' file; do
            if should_stamp_path "$file"; then
                stamp_path "$file" || return 1
            fi
        done
    else
        shopt -s dotglob nullglob
        for file in ./*; do
            if should_stamp_path "$file"; then
                stamp_path "$file" || return 1
            fi
        done
    fi
}

print_help() {
    cat <<'HELP'
Usage:
  folderstamp display [--recursive|-r]
  folderstamp save [--recursive|-r]
  folderstamp resume PATH_TO_FOLDERSTAMP_INCOMPLETE
  folderstamp --help

Commands:
  display              Print a snapshot to standard output.
  save                 Create a resumable snapshot under .meta/folderstamp/.
  resume PATH          Continue a selected folderstamp.incomplete file.

Hidden files are included. Symbolic links are recorded as links and never
followed or hashed. VCS databases (.git, .pijul, .hg and .svn), the internal
stamp store, and legacy .folderstamp* files are excluded. .folderstampignore
supports a limited gitignore-like syntax, not the complete Git ignore engine.

Incomplete snapshots keep their .incomplete extension and a private checkpoint.
Resume from the same original directory and do not modify the file tree while
resuming; the saved file list preserves the original traversal order.
HELP
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
       print_help
    elif [[ "${1:-}" == "save" ]]; then
       save_folderstamp "$1" "${2:-}"
    elif [[ "${1:-}" == "resume" ]]; then
       if [[ -z "${2:-}" ]]; then
           echo "resume requires the path to a folderstamp.incomplete file." >&2
           print_help >&2
           exit 2
       fi
       resume_folderstamp "$2"
    elif [[ "${1:-}" == "display" ]]; then
       display "$1" "${2:-}"
    else
       echo "Unknown command: ${1:-<none>}" >&2
       print_help >&2
       exit 2
    fi
fi

