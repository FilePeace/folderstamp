#!/bin/bash -e

FOLDERSTAMP_VERSION="r6"

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

platform_name() {
    local uname_s uname_o
    uname_s="$(uname -s 2>/dev/null || echo unknown)"
    uname_o="$(uname -o 2>/dev/null || echo unknown)"

    if [[ -n "${TERMUX_VERSION:-}" ]] || [[ "${PREFIX:-}" == *com.termux* ]] || [[ "$uname_o" == "Android" ]]; then
        echo "Termux"
    elif [[ "$uname_s" == CYGWIN* ]]; then
        echo "Cygwin"
    elif [[ "$uname_s" == "Redox" ]]; then
        echo "RedoxOS"
    elif [[ "$uname_s" == "Darwin" ]]; then
        echo "macOS"
    elif [[ "$uname_s" == *BSD ]]; then
        echo "BSD"
    elif [[ "$uname_s" == "Fuchsia" ]] || [[ "$uname_s" == "Zircon" ]]; then
        echo "Zircon/Fuchsia"
    else
        echo "$uname_s"
    fi
}


install_command_for() {
    local package="$1"
    local platform
    platform="$(platform_name)"

    case "$platform" in
        Termux)
            echo "pkg install $package"
            ;;
        Cygwin)
            echo "Install the '$package' package with the Cygwin setup executable."
            ;;
        RedoxOS)
            echo "pkg install $package"
            ;;
        macOS)
            if command_exists brew; then
                echo "brew install $package"
            else
                echo "Install '$package' with Homebrew, MacPorts, or the upstream project release."
            fi
            ;;
        BSD)
            if command_exists pkg; then
                echo "pkg install $package"
            elif command_exists pkg_add; then
                echo "pkg_add $package"
            else
                echo "Install '$package' with your BSD package manager."
            fi
            ;;
        Zircon/Fuchsia)
            echo "Install '$package' with the Fuchsia package workflow for your image/build."
            ;;
        Linux)
            if command_exists apt-get; then
                echo "sudo apt-get update && sudo apt-get install -y $package"
            elif command_exists dnf; then
                echo "sudo dnf install -y $package"
            elif command_exists pacman; then
                echo "sudo pacman -S --needed $package"
            elif command_exists apk; then
                echo "sudo apk add $package"
            elif command_exists zypper; then
                echo "sudo zypper install -y $package"
            else
                echo "Install '$package' with your distribution package manager."
            fi
            ;;
        *)
            echo "Install '$package' with the package manager for $(platform_name)."
            ;;
    esac
}


normalized_arch() {
    local arch
    arch="$(uname -m 2>/dev/null || echo unknown)"

    case "$arch" in
        x86_64|amd64) echo "amd64" ;;
        aarch64|arm64) echo "arm64" ;;
        armv7*|armv6*) echo "arm" ;;
        *) echo "$arch" ;;
    esac
}

github_os_token() {
    case "$(platform_name)" in
        Linux|Termux) echo "linux" ;;
        macOS) echo "darwin" ;;
        BSD) echo "freebsd" ;;
        Cygwin) echo "windows" ;;
        *) echo "" ;;
    esac
}

install_bin_dir() {
    if [[ -n "${PREFIX:-}" && -w "${PREFIX}/bin" ]]; then
        echo "${PREFIX}/bin"
    elif [[ -d "$HOME/.local/bin" || -w "$HOME" ]]; then
        mkdir -p "$HOME/.local/bin" 2>/dev/null || true
        echo "$HOME/.local/bin"
    else
        echo "/usr/local/bin"
    fi
}

install_release_asset() {
    local repo="$1"
    local label="$2"
    local asset_regex="$3"
    local bin_name="$4"
    local release_tag="${5:-latest}"
    local os_token arch token url archive workdir dest release_api

    if ! command_exists curl; then
        echo "Cannot auto-install $label: curl is missing."
        echo "Suggested install: $(install_command_for curl)"
        return 1
    fi

    if ! command_exists tar; then
        echo "Cannot auto-install $label: tar is missing."
        echo "Suggested install: $(install_command_for tar)"
        return 1
    fi

    if ! command_exists python3; then
        echo "Cannot auto-install $label safely: python3 is missing for GitHub release asset selection."
        echo "Open instead: https://github.com/$repo/releases/latest"
        return 1
    fi

    os_token="$(github_os_token)"
    arch="$(normalized_arch)"
    token="${os_token}-${arch}"

    if [[ -z "$os_token" ]]; then
        echo "Cannot auto-install $label on $(platform_name) yet. Open: https://github.com/$repo/releases/latest"
        return 1
    fi

    if [[ "$release_tag" == "latest" ]]; then
        release_api="https://api.github.com/repos/$repo/releases/latest"
    else
        release_api="https://api.github.com/repos/$repo/releases/tags/$release_tag"
    fi

    url="$(curl -fsSL "$release_api" | python3 -c '
import json, re, sys
os_token = sys.argv[1].lower()
arch = sys.argv[2].lower()
regex = re.compile(sys.argv[3], re.I)
arch_aliases = {
    "amd64": ["amd64", "x86_64"],
    "arm64": ["arm64", "aarch64"],
    "arm": ["arm", "armv7", "armv6"],
}
arches = arch_aliases.get(arch, [arch])
data = json.load(sys.stdin)
for asset in data.get("assets", []):
    name = asset.get("name", "")
    low = name.lower()
    if os_token in low and any(a in low for a in arches) and regex.search(name):
        print(asset.get("browser_download_url", ""))
        break
' "$os_token" "$arch" "$asset_regex")"

    if [[ -z "$url" ]]; then
        echo "No matching $label release asset found for $token."
        echo "Open: https://github.com/$repo/releases/latest"
        return 1
    fi

    workdir="$(mktemp -d 2>/dev/null || mktemp -d -t folderstamp)"
    archive="$workdir/asset.tar.gz"
    dest="$(install_bin_dir)/$bin_name"

    echo "Downloading $label ($release_tag) from: $url"
    curl -fL "$url" -o "$archive"
    tar -xzf "$archive" -C "$workdir"

    found="$(find "$workdir" -type f -name "$bin_name" -perm -u+x 2>/dev/null | head -n1)"
    if [[ -z "$found" ]]; then
        found="$(find "$workdir" -type f -name "$bin_name" 2>/dev/null | head -n1)"
    fi

    if [[ -z "$found" ]]; then
        echo "Downloaded $label, but could not find $bin_name inside the archive."
        echo "Workdir kept for inspection: $workdir"
        return 1
    fi

    cp "$found" "$dest"
    chmod +x "$dest"
    echo "$label installed at $dest"
}

ask_yes_no() {
    local question="$1"
    local answer

    if [[ ! -t 0 ]]; then
        return 1
    fi

    printf "%s [Y/n] " "$question"
    read -r answer
    case "$answer" in
        n|N|no|NO|No) return 1 ;;
        *) return 0 ;;
    esac
}

run_privileged() {
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
        "$@"
    elif command_exists sudo; then
        sudo "$@"
    else
        echo "Cannot run the system package manager: administrator privileges are required and sudo is unavailable."
        return 1
    fi
}

offer_gitoxide_install() {
    if ask_yes_no "Install Gitoxide/gix from GitHub Releases now?"; then
        install_release_asset "GitoxideLabs/gitoxide" "Gitoxide" 'gitoxide.*(tar\.gz|tgz)$' "gix"
    else
        gitoxide_install_offer
    fi
}

install_uutils_stat_compatibility() {
    local bin_dir

    # uutils ships one multicall `coreutils` binary. Its launcher keeps the usual
    # `stat` command-line interface available in the user's private bin directory;
    # it never replaces a system-provided stat.
    install_release_asset "uutils/coreutils" "uutils/coreutils" 'coreutils.*(tar\.gz|tgz)$' "coreutils" || return 1
    bin_dir="$(install_bin_dir)"
    cat > "$bin_dir/stat" <<'STAT_WRAPPER'
#!/bin/sh
exec "$(dirname "$0")/coreutils" stat "$@"
STAT_WRAPPER
    chmod +x "$bin_dir/stat"
    echo "uutils/coreutils compatible stat installed at $bin_dir/stat"
}

install_normal_stat() {
    local platform
    platform="$(platform_name)"

    # Prefer the platform package: folderstamp needs the conventional `stat`
    # command, not an implicit replacement installed behind the user's back.
    case "$platform" in
        Termux)
            pkg install -y coreutils
            ;;
        RedoxOS)
            pkg install coreutils
            ;;
        Linux)
            if command_exists apt-get; then
                run_privileged apt-get update && run_privileged apt-get install -y coreutils
            elif command_exists dnf; then
                run_privileged dnf install -y coreutils
            elif command_exists pacman; then
                run_privileged pacman -S --needed coreutils
            elif command_exists apk; then
                run_privileged apk add coreutils
            elif command_exists zypper; then
                run_privileged zypper install -y coreutils
            else
                echo "No supported Linux package manager was found."
                echo "Install the normal stat command with: $(install_command_for coreutils)"
                return 1
            fi
            ;;
        Cygwin)
            echo "Install the normal stat command by selecting the Cygwin 'coreutils' package."
            return 1
            ;;
        macOS|BSD)
            # These platforms ship stat as part of their base system. If it is
            # absent, a damaged/minimal image needs its vendor package workflow.
            echo "$platform normally provides stat in its base system."
            echo "Restore the platform core utilities or use: $(install_command_for coreutils)"
            return 1
            ;;
        *)
            echo "Install the normal stat command with: $(install_command_for coreutils)"
            return 1
            ;;
    esac
}

offer_normal_stat_install() {
    if ask_yes_no "Install the normal stat command with this platform's package manager now?"; then
        install_normal_stat
    else
        echo "Normal stat install: $(install_command_for coreutils)"
        return 1
    fi
}

offer_uutils_stat_install() {
    if ask_yes_no "Install uutils/coreutils, a Rust-compatible stat alternative, from GitHub Releases now?"; then
        install_uutils_stat_compatibility
    else
        echo "Rust-compatible alternative: https://github.com/uutils/coreutils/releases/latest"
        return 1
    fi
}

# Iroh's current releases ship relay/DNS binaries, not the blob CLI. v0.28.1 is
# the newest release line that ships the standalone `iroh` blob command.
offer_iroh_install() {
    if ask_yes_no "Install the Iroh blob CLI from GitHub Releases now?"; then
        install_release_asset "n0-computer/iroh" "Iroh blob CLI" '(^|/)iroh-v.*(tar\.gz|tgz)$' "iroh" "v0.28.1"
    else
        echo "Iroh blob CLI release: https://github.com/n0-computer/iroh/releases/tag/v0.28.1"
    fi
}

gitoxide_install_offer() {
    cat <<'GITOXIDE_EOF'
You can install classic Git with your package manager, or install Gitoxide from GitHub Releases:
  https://github.com/GitoxideLabs/gitoxide/releases/latest
Gitoxide usually provides the `gix` command; choose the asset for your OS/CPU architecture.
GITOXIDE_EOF
}

check_git_tooling() {
    if command_exists git; then
        echo "Dependency OK: git ($(command -v git))"
        if ! command_exists gix; then
            echo "Gitoxide/gix not found; Gitoxide is the default optional VCS accelerator."
            offer_gitoxide_install || true
        fi
        return 0
    fi

    if command_exists gix; then
        echo "Dependency OK: gitoxide/gix ($(command -v gix))"
        return 0
    fi

    echo "Dependency missing: git or gitoxide/gix"
    echo "Suggested Git install: $(install_command_for git)"
    offer_gitoxide_install || true
    return 1
}

check_optional_dependency() {
    local command_name="$1"
    local package_name="${2:-$1}"

    if command_exists "$command_name"; then
        echo "Optional dependency OK: $command_name ($(command -v "$command_name"))"
        return 0
    fi

    echo "Optional dependency missing: $command_name"
    echo "Suggested install: $(install_command_for "$package_name")"
    return 1
}

check_stat_tooling() {
    if command_exists stat; then
        echo "Dependency OK: stat ($(command -v stat))"
        return 0
    fi

    echo "Dependency missing: stat"
    echo "The normal platform stat command is required for file metadata."
    echo "Suggested normal install: $(install_command_for coreutils)"
    offer_normal_stat_install || true

    if command_exists stat; then
        echo "Dependency OK after installation: stat ($(command -v stat))"
        return 0
    fi

    echo "Normal stat is still unavailable; uutils/coreutils is an optional Rust-compatible fallback."
    offer_uutils_stat_install || true
    return 1
}

check_iroh_tooling() {
    if command_exists iroh; then
        echo "Optional dependency OK: iroh ($(command -v iroh))"
        return 0
    fi

    echo "Optional dependency missing: iroh (preferred BLAKE3 content-addressing tool)"
    offer_iroh_install || true
    return 1
}

check_python_blake3() {
    if command_exists python3 && python3 -c 'import blake3' >/dev/null 2>&1; then
        echo "Optional fallback OK: python3 blake3 module"
        return 0
    fi

    echo "Optional fallback missing: Python 3 with the blake3 module"
    echo "Suggested install: python3 -m pip install --user blake3"
    return 1
}

check_dependency() {
    local command_name="$1"
    local package_name="${2:-$1}"

    if command_exists "$command_name"; then
        echo "Dependency OK: $command_name ($(command -v "$command_name"))"
        return 0
    fi

    echo "Dependency missing: $command_name"

    echo "Suggested install: $(install_command_for "$package_name")"

    return 1
}

print_dependency_report() {
    echo "Dependency check:"
    check_stat_tooling || true
    check_git_tooling || true
    check_optional_dependency pijul pijul || true
    check_iroh_tooling || true
    check_python_blake3 || true
    check_optional_dependency ipfs kubo || true
}

print_storage_details() {
    local mount_source
    mount_source="$(df -P . 2>/dev/null | awk 'NR==2 {print $1}')"

    if [[ -n "$mount_source" ]] && command_exists lsblk; then
        lsblk -o NAME,SIZE,TYPE,VENDOR,MODEL 2>/dev/null \
            | awk -v device="$mount_source" 'index(device, "/" $1) || device == $1 {print "Storage Device: " $0}'
        return 0
    fi

    if command_exists df; then
        df -hP . 2>/dev/null | awk 'NR==2 {print "Storage Device: " $1 " mounted on " $6 " (" $2 " total, " $4 " available)"}'
        return 0
    fi

    echo "Storage Device: unavailable on this platform"
}

print_git_details() {
    local current_branch first_remote_name first_remote_url

    if [[ -d ".git" ]] && command_exists git; then
        current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
        first_remote_name="$(git remote 2>/dev/null | head -n1)"
        echo "Current Git Branch: ${current_branch:-unknown}"

        if [[ -n "$first_remote_name" ]]; then
            first_remote_url="$(git remote get-url "$first_remote_name" 2>/dev/null || true)"
            echo "First Git Remote: $first_remote_name - URL: ${first_remote_url:-unknown}"
        else
            echo "First Git Remote: none"
        fi
    elif [[ -d ".git" ]] && command_exists gix; then
        echo "Git repository detected; Gitoxide available: $(command -v gix)"
        echo "Current Git Branch: unavailable without classic git"
    fi
}

print_pijul_details() {
    local current_channel

    if [[ -d ".pijul" ]] && command_exists pijul; then
        current_channel="$(pijul channel 2>/dev/null | awk '/\*/ {print $2; exit}')"
        echo "Current Pijul Channel: ${current_channel:-unknown}"
    elif [[ -d ".pijul" ]]; then
        echo "Pijul repository detected, but pijul is not installed."
        echo "Suggested install: $(install_command_for pijul)"
    fi
}

cid_v0_basic_python() {
    local file="$1"

    python3 - "$file" <<'PY_CID'
import hashlib
import sys

ALPHABET = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"


def varint(value: int) -> bytes:
    out = bytearray()
    while value >= 0x80:
        out.append((value & 0x7F) | 0x80)
        value >>= 7
    out.append(value)
    return bytes(out)


def field_varint(number: int, value: int) -> bytes:
    return varint((number << 3) | 0) + varint(value)


def field_bytes(number: int, value: bytes) -> bytes:
    return varint((number << 3) | 2) + varint(len(value)) + value


def b58encode(data: bytes) -> str:
    n = int.from_bytes(data, "big")
    chars = []
    while n:
        n, rem = divmod(n, 58)
        chars.append(ALPHABET[rem])
    prefix = "1" * (len(data) - len(data.lstrip(b"\0")))
    return prefix + "".join(reversed(chars or ["1"]))

path = sys.argv[1]
with open(path, "rb") as handle:
    payload = handle.read()

# Basic CIDv0 study/implementation for a single-block UnixFS file:
# UnixFS Data: Type=File(2), Data=<bytes>, filesize=<len>.
unixfs_data = field_varint(1, 2) + field_bytes(2, payload) + field_varint(3, len(payload))
# DAG-PB PBNode: Data=<UnixFS Data>. No links/chunking in this basic fallback.
pb_node = field_bytes(1, unixfs_data)
digest = hashlib.sha256(pb_node).digest()
multihash = bytes([0x12, 0x20]) + digest
print(b58encode(multihash))
PY_CID
}

cid_v1_blake3_python() {
    local file="$1"

    python3 - "$file" <<'PY_BLAKE3'
import base64
import sys
import blake3


def varint(value: int) -> bytes:
    out = bytearray()
    while value >= 0x80:
        out.append((value & 0x7F) | 0x80)
        value >>= 7
    out.append(value)
    return bytes(out)

with open(sys.argv[1], "rb") as handle:
    digest = blake3.blake3(handle.read()).digest()

# CIDv1 + raw codec (0x55) + BLAKE3-256 multihash (0x1e, 32 bytes).
cid = varint(1) + varint(0x55) + varint(0x1e) + varint(len(digest)) + digest
print("b" + base64.b32encode(cid).decode("ascii").lower().rstrip("="))
PY_BLAKE3
}

iroh_blake3_hash() {
    local file="$1"
    local output hash

    # The legacy Iroh CLI starts a local node when asked, then reports the blob hash.
    output="$(iroh --start blobs add --no-ticket "$file" 2>&1)" || return 1
    hash="$(printf '%s\n' "$output" | sed -nE 's/^(Blob )?[Hh]ash:?[[:space:]]+([^[:space:]]+).*$/\2/p' | head -n1)"
    [[ -n "$hash" ]] || return 1
    printf '%s\n' "$hash"
}

print_cid_hash() {
    local file="$1"
    local hash

    if command_exists iroh && hash="$(iroh_blake3_hash "$file")"; then
        # Iroh exposes a BLAKE3 BlobId, not an IPFS CID. Name it accurately.
        echo "Content hash (Iroh BLAKE3): $hash"
    elif command_exists python3 && python3 -c 'import blake3' >/dev/null 2>&1; then
        echo "CID hash (CIDv1/raw/BLAKE3): $(cid_v1_blake3_python "$file")"
    elif command_exists ipfs; then
        # Kubo remains compatible, but is deliberately not the default provider.
        echo "CID hash (Kubo/IPFS fallback): $(ipfs add -q --only-hash "$file")"
    elif command_exists python3; then
        echo "CID hash (CIDv0 basic): $(cid_v0_basic_python "$file")"
    else
        echo "CID hash: unavailable (install Iroh, Python 3 + blake3, or Kubo/IPFS)"
    fi
}

stamp_path() {
    local file="$1"
    local all

    all=$(printf '\n'; if command_exists stat; then stat "$file" 2>/dev/null || echo "stat failed for: $file"; else echo "stat unavailable for: $file"; echo "Suggested install: $(install_command_for coreutils)"; fi; print_cid_hash "$file"; printf '%s\n' '------------------------------')
    printf "%s" "$all" | sed 's/%/%%/g'
}

folderstamp_store_dir() {
    echo ".meta/folderstamp"
}

legacy_folderstamp_path() {
    echo ".folderstamp"
}

next_folderstamp_path() {
    local store_dir="$1"
    local max=0
    local path name number

    if [[ -f "$store_dir/.folderstamp" ]]; then
        max=1
    fi

    for path in "$store_dir"/.folderstamp.*; do
        [[ -e "$path" ]] || continue
        name="${path##*/}"
        number="${name##*.}"
        if [[ "$number" =~ ^[0-9]+$ ]] && (( number > max )); then
            max="$number"
        fi
    done

    if (( max == 0 )); then
        echo "$store_dir/.folderstamp"
    else
        echo "$store_dir/.folderstamp.$((max + 1))"
    fi
}

prepare_folderstamp_output_path() {
    local store_dir legacy_path next_path
    store_dir="$(folderstamp_store_dir)"
    legacy_path="$(legacy_folderstamp_path)"

    mkdir -p "$store_dir"

    if [[ -f "$legacy_path" ]]; then
        if [[ ! -e "$store_dir/.folderstamp.1" ]]; then
            mv "$legacy_path" "$store_dir/.folderstamp.1"
        else
            mv "$legacy_path" "$(next_folderstamp_path "$store_dir")"
        fi
    fi

    next_path="$(next_folderstamp_path "$store_dir")"
    echo "$next_path"
}

save_folderstamp() {
    local output_path
    output_path="$(prepare_folderstamp_output_path)"

    echo "🤓📝 Working..."
    echo "Saving folderstamp to: $output_path"
    display "$1" "$2" > "$output_path"
}

